# Example environment variables
# Copy this file to .env and fill in your values

# Paths
DATA_ROOT=./data
MODELS_ROOT=./models
OUTPUTS_ROOT=./outputs

# Training
BATCH_SIZE=16
NUM_WORKERS=4
LEARNING_RATE=0.001
NUM_EPOCHS=100

# Hardware
DEVICE=cuda
GPU_ID=0

# Logging
LOG_LEVEL=INFO
TENSORBOARD_DIR=./outputs/logs/tensorboard

# Dataset paths (update after downloading)
WIDER_FACE_PATH=./data/raw/WIDER_FACE
CELEBAMASK_HQ_PATH=./data/raw/CelebAMask-HQ

# Model configs
DETECTION_CONFIG=./models/configs/dsfd_config.yaml
SEGMENTATION_CONFIG=./models/configs/segmentation_config.yaml

# Inference
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.3
MAX_DETECTIONS=100
